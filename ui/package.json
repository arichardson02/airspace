{
  "name": "@fs-career/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Airspace design shared by the website and the desktop app: theme tokens, fonts and base components.",
  "exports": {
    "./theme.css": "./theme.css",
    "./fonts/*": "./fonts/*",
    "./button": "./src/primitives/button.tsx",
    "./field": "./src/primitives/field.tsx",
    "./panel": "./src/primitives/panel.tsx",
    "./logo": "./src/brand/logo.tsx",
    "./mark": "./src/brand/mark.tsx",
    "./cn": "./src/cn.ts",
    "./flight-map": "./src/motion/flight-map.tsx",
    "./intro": "./src/motion/intro.tsx",
    "./motion": "./src/motion/motion.ts",
    "./shell": "./src/shell/index.ts",
    "./instruments": "./src/instruments/index.ts",
    "./map": "./src/map/index.ts"
  },
  "files": [
    "fonts",
    "src",
    "theme.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "world-dots": "node scripts/world-dots.mts",
    "basemap": "node scripts/basemap.mts",
    "airports": "node scripts/airports.mts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "6.14.0",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0"
  },
  "peerDependencies": {
    "framer-motion": "^14.6.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "framer-motion": "^14.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5",
    "world-atlas": "^2.0.2"
  },
  "packageManager": "pnpm@12.15.0"
}
