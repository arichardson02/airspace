{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    // Every file is its own module, so the sim-package scripts (no imports or exports) don't share one global scope;
    // declaration files (sim-package/globals.d.ts) stay global.
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "sim-package"]
}
