{
  "name": "desktop",
  "productName": "Airspace",
  "version": "0.1.0",
  "private": true,
  "description": "The Airspace desktop app for Microsoft Flight Simulator.",
  "author": "Airspace",
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm typecheck && node scripts/build.mjs && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@fs-career/contracts": "workspace:*",
    "@fs-career/ui": "workspace:*",
    "@geckos.io/snapshot-interpolation": "^1.1.1",
    "@orpc/client": "^1.16.1",
    "@orpc/openapi-client": "^1.16.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-updater": "6.8.11",
    "esbuild": "0.28.2",
    "framer-motion": "^14.6.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "node-datachannel": "^0.33.5",
    "node-simconnect": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7"
  },
  "build": {
    "appId": "club.airspace.desktop",
    "productName": "Airspace",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**",
      "dist/renderer/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/native/node_datachannel.node",
        "to": "node_datachannel.node"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Airspace",
      "artifactName": "Airspace-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "arichardson02",
      "repo": "airspace",
      "tagNamePrefix": "desktop-v"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
