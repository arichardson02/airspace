{
  "compilerOptions": {
    "target": "ES2023",
    // Node only: the DOM library's WebSocket would hide undici's, which takes headers.
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["electron"]
}
